{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	// Vendored extensions keep their upstream compiler assumptions in dedicated
	// tsconfigs and are typechecked through the root `typecheck` script. node_modules
	// must be listed explicitly because specifying `exclude` overrides TypeScript's
	// default excludes.
	"exclude": [
		"node_modules",
		"agent/extensions/web-tools",
		"agent/extensions/openai-server-compaction"
	]
}
