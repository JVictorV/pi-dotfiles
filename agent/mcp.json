{
	"imports": ["cursor", "claude-code", "claude-desktop"],
	"mcpServers": {
		"notion": {
			"url": "https://mcp.notion.com/mcp"
		},
		"figma": {
			"command": "npx",
			"args": ["-y", "figma-developer-mcp", "--stdio"],
			"env": {
				"FIGMA_API_KEY": "$env:FIGMA_API_KEY"
			}
		},
		"ghidra": {
			"command": "/home/ubuntu/.local/opt/ghidra-headless-mcp/.venv/bin/ghidra-headless-mcp",
			"args": ["--ghidra-install-dir", "/home/ubuntu/.local/opt/ghidra"],
			"env": {
				"TMPDIR": "/home/ubuntu/ghidra-work/tmp"
			}
		}
	}
}
